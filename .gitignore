# Build artifacts
/bin/
/agent
/dist/
/vendor/
/tmp/
*.test
*.out

# Local RAG index (DO NOT COMMIT — single-writer SQLite file)
/index.db
/index.db-journal
/index.db-wal
/index.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# Local config / secrets (never commit)
/.env
/.env.*
/config.local.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python / rag_eval harness (rag_eval/)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
/rag_eval/*.egg-info/
/rag_eval/logs/
# Generated by rag_eval: datasets, experiment results, and trace logs are
# outputs, not inputs. Keep the .gitkeep files so the directories exist.
/rag_eval/evals/datasets/*
/rag_eval/evals/experiments/*
!/rag_eval/evals/logs/
/rag_eval/evals/logs/*
!/rag_eval/evals/*/.gitkeep
# Promptfoo red-team artifacts (config lives in tests-ai/)
/tests-ai/redteam.yaml
/tests-ai/results.json
/redteam.yaml
/.promptfoo/
