# Build artifacts
/bin/
/agent
/dist/
/vendor/
/tmp/
*.test
*.out

# Local RAG index (DO NOT COMMIT — single-writer SQLite file)
/index.db
/index.db-journal
/index.db-wal
/index.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# Local config / secrets (never commit)
/.env
/.env.*
/config.local.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python / Ragas harness (evals/)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
/evals/*.egg-info/
/evals/logs/
# Generated by evals/evaluate.py: datasets, experiment results, and trace
# logs are outputs, not inputs. Keep the .gitkeep so output/ exists.
/evals/output/*
!/evals/output/.gitkeep
# Promptfoo red-team suite (config, package manifest, and README live in
# tests-ai/). node_modules, the local promptfoo database, generated attacks,
# and reports are outputs: keep .gitkeep so reports/ exists in a fresh clone.
/tests-ai/redteam.yaml
/tests-ai/node_modules/
/tests-ai/.promptfoo/
/tests-ai/.env
/tests-ai/.env.*
/tests-ai/reports/*
!/tests-ai/reports/.gitkeep
# Defensive: a promptfoo run started from the repository root also writes here.
/redteam.yaml
/.promptfoo/
