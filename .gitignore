# Build artifacts
/bin/
/agent
/dist/
/vendor/
/tmp/
*.test
*.out

# Local RAG index (DO NOT COMMIT — single-writer SQLite file)
/index.db
/index.db-journal
/index.db-wal
/index.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# Local config / secrets (never commit)
/.env
/.env.*
/config.local.yaml
# A2A bearer tokens (agent tokens add writes this 0600 file)
/a2a-tokens.txt
/.a2a-tokens-*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python / Ragas harness (evals/)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
/evals/*.egg-info/
/evals/logs/
# Generated by evals/evaluate.py: datasets, experiment results, and trace
# logs are outputs, not inputs. Keep the .gitkeep so output/ exists.
/evals/output/*
!/evals/output/.gitkeep
# Promptfoo red-team artifacts (config lives in tests-ai/)
/tests-ai/redteam.yaml
/tests-ai/results.json
/redteam.yaml
/.promptfoo/
