#!/usr/bin/env bash
# ask — thin wrapper over `agent ask` (PLAN.md Phase 2).
#
# The grounded tool-calling loop lives in the binary; this wrapper only keeps
# the `scripts/ask "question"` muscle memory working from any directory.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ ! -x "$root/agent" ]; then
  echo "ask: $root/agent not found; build it with 'go build -tags sqlite_fts5 -o agent ./cmd/agent'" >&2
  exit 1
fi

# The binary loads .env and resolves ./index.db relative to the working
# directory, so run from the repo root rather than the caller's directory.
cd "$root"
exec "$root/agent" ask "$@"
