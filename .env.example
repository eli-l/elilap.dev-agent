# .env.example - copy to .env and fill in the credentials.
#
# The agent reads these from the process environment. It does NOT parse .env
# itself, so load it before running a command:
#
#     set -a; . ./.env; set +a      # POSIX shells
#     make setup                     # creates .env from this file
#
# .env is gitignored - never commit it, and never paste a credential value
# into sources.yaml or into a doc. Every value below is either empty (fill
# it in) or a default the code already falls back to. The reference
# environment is described in PLAN.md section 7; point these at your own
# endpoints.

# --- model server (OpenAI-compatible) ---
# Base URL of the endpoint serving /v1/embeddings and /v1/chat/completions.
# It must end in /v1.
LOCALAI_BASE_URL=http://localhost:8080/v1
# Embedding model id; must return 768-dimension vectors.
EMBED_MODEL=embeddinggemma-300m
# Chat model id.
CHAT_MODEL=spark-x2.5-4b
# Optional bearer token. Self-hosted servers usually need none; leave it
# empty unless yours does.
LOCALAI_API_KEY=

# --- index ---
# Path of the SQLite index file. Keep it with its -wal/-shm siblings.
AGENT_DB_PATH=./index.db

# --- Ghost Admin API ---
# Credentials for the blog source.
GHOST_API_URL=
GHOST_API_KEY=

# --- Postiz API ---
# Credentials for the social cross-post source.
POSTIZ_API_URL=
POSTIZ_API_KEY=
