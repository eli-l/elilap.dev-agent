# example.env - template for the agent's environment configuration.
#
#   cp example.env .env     # then fill in the credentials
#
# The binary loads .env at startup (godotenv) from the working directory.
# Variables already set in the real environment win over the file, so
# containers, cron, and launchd override a developer's local .env.
#
# RULE: every environment variable the agent reads is listed here. Secrets get
# an empty value; everything else carries its default. A new variable is not
# added to the code until it is added here and to docs/environment.md.
# .env is gitignored; this file is committed.

# --- Logging (internal/logging) -------------------------------------------
# Level: trace|debug|info|warn|error|fatal|panic|disabled
# Format: text|json
AGENT_LOG_LEVEL=info
AGENT_LOG_FORMAT=text

# --- SQLite index (internal/store) ---------------------------------------
# One file per host: ./data/index.db locally, /data/index.db in the container.
AGENT_DB_PATH=./data/index.db

# --- Model backend (internal/llm, internal/embed) ------------------------
# Any OpenAI-compatible server. The default is the verified self-hosted
# LocalAI instance (PLAN.md Decision 10).
LOCALAI_BASE_URL=http://192.168.78.243:8080/v1
# Optional bearer token; leave empty when the backend needs none.
LOCALAI_API_KEY=
EMBED_MODEL=embeddinggemma-300m
CHAT_MODEL=Spark-X2.6-4B-q8_0

# --- evals harness (evals/, Python/Ragas) --------------------------
# Separate from LOCALAI_* on purpose: the harness can score a different
# endpoint/model than the agent. Empty EVAL_API_KEY falls back to "local".
EVAL_BASE_URL=http://localhost:8000/v1
EVAL_MODEL=mtplx-qwen36-35b-a3b-optimized-speed
EVAL_API_KEY=

# --- Source credentials (referenced by sources.yaml as { env: VAR }) -----
# The names live in sources.yaml; only the values belong here.
GHOST_API_URL=
GHOST_API_KEY=
POSTIZ_API_URL=
POSTIZ_API_KEY=

# --- A2A surface (agent serve, internal/auth) ---------------------------
# Read-only bearer tokens as a comma-separated id:token list. Values are
# secrets; issue them with `agent tokens add` rather than typing them.
AGENT_A2A_TOKENS=
# 0600 token file, re-read when it changes (rotation needs no restart).
# A missing file means no tokens: loopback serving stays token-less.
AGENT_A2A_TOKENS_FILE=./data/a2a-tokens.txt
# Absolute service root advertised in the agent card. Required with
# --bind-public; a loopback bind derives http://<addr> when this is empty.
AGENT_A2A_PUBLIC_URL=
